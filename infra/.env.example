# Copier ce fichier en ".env" sur le VPS, ne JAMAIS committer le ".env" réel.
# Permissions recommandées sur le VPS : chmod 600 .env
#
# Mis à jour le 16/08/2026 - reflète l'ensemble des services existant à
# cette date (26 migrations, 15 services). Toute variable listée ici a
# été vérifiée par recherche exhaustive dans le code (grep os.environ),
# jamais reconstituée de mémoire.

# --- Registre d'images ---
IMAGE_REGISTRY=ghcr.io/votre-utilisateur-github
IMAGE_TAG=latest

# --- Domaine ---
DOMAIN_NAME=votre-domaine.example.com
PUBLIC_API_URL=https://votre-domaine.example.com/api

# --- Base de données ---
POSTGRES_DB=quant_platform
POSTGRES_USER=quant_app
POSTGRES_PASSWORD=changez-moi-avec-un-mot-de-passe-fort
DATABASE_URL=postgresql://quant_app:changez-moi-avec-un-mot-de-passe-fort@timescaledb:5432/quant_platform

# --- Redis ---
REDIS_PASSWORD=changez-moi-aussi
REDIS_URL=redis://:changez-moi-aussi@redis:6379/0

# --- Exchanges actifs (ADR-0012) ---
# Liste séparée par des virgules - un adaptateur et un mapping de
# symboles doivent exister pour chaque exchange listé
# (data_collector/adapters/, shared/symbol_mapping.py).
ACTIVE_EXCHANGES=htx

# --- Clés API SPOT par exchange - permissions "trading" uniquement,
# JAMAIS "retrait" (ADR-0012 : remplace EXCHANGE_API_KEY/SECRET
# génériques, ambigus dès qu'il y a plus d'un exchange actif) ---
# Voir "Configuration Binance" dans README.md pour la procédure complète.
HTX_API_KEY=
HTX_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Clés API FUTURES par exchange (Étapes 7-8, 16/08/2026) - TOUJOURS
# des clés séparées des clés spot ci-dessus, jamais partagées. HTX
# futures existe depuis ADR-0018 ; Binance futures depuis les Étapes 7-8. ---
HTX_FUTURES_API_KEY=
HTX_FUTURES_API_SECRET=
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# --- Paires suivies par exchange ---
# Spot (natif, ex. "btcusdt,ethusdt") - retombe sur TRACKED_SYMBOLS
# (générique) si la variable spécifique à l'exchange n'est pas définie.
TRACKED_SYMBOLS=btcusdt,ethusdt,solusdt
# TRACKED_SYMBOLS_HTX=btcusdt,ethusdt,solusdt
# TRACKED_SYMBOLS_BINANCE=btcusdt,ethusdt,solusdt

# Futures Binance (chantier de données Liquidation Cascade, 16/08/2026) -
# alimente liquidation_ingest, format natif Binance (ex. "btcusdt").
# TRACKED_SYMBOLS_BINANCE_FUTURES=btcusdt,ethusdt,solusdt

# Format canonique (pair_execution uniquement, ex. "BTC/USDT,ETH/USDT").
# TRACKED_SYMBOLS_CANONICAL=BTC/USDT,ETH/USDT,SOL/USDT

# --- CostModel (ADR-0016, étendu Binance à l'Étape 2) - fréquence de
# mesure des frais réels du compte. Quotidien par défaut : un palier
# tarifaire ne se recalcule pas plus vite que ça en pratique (dépend
# d'un volume glissant sur 30 jours) - inutile d'interroger l'API plus
# souvent.
# COST_MODEL_INTERVAL_SECONDS=86400

# --- Strategy Lifecycle Manager (Étape 3, 16/08/2026) - fréquence de
# réévaluation de l'éviction/résurrection automatique des stratégies.
# STRATEGY_LIFECYCLE_INTERVAL_SECONDS=3600

# --- Pair Execution (funding/basis, ADR-0021) - fréquence d'évaluation.
# Toujours en mode paper à ce jour (ADR-0021 §7 : formule d'entrée
# corrigée, mais mécanisme de sortie encore absent - cf. audit).
# PAIR_EXECUTION_INTERVAL_SECONDS=60

# --- Levier futures (Étapes 7-8, 16/08/2026) ---
# Décision CTO : plafond système à 2x (shared/futures_margin.py,
# MAX_LEVERAGE) - mais AUCUN adaptateur ne l'envoie encore réellement à
# l'exchange (ACTUAL_LEVERAGE=1 partout, cf. docstring du module) ;
# rien à configurer ici tant que cette activation n'est pas décidée
# consciemment.

# --- Routage futures pour le short (ADR-0019) ---
# false par défaut : un SELL sans position spot existante est refusé
# (SpotNoShortingRule), jamais silencieusement routé vers le futures.
# À activer explicitement seulement après avoir validé Binance Futures
# en paper (Étapes 7-9).
FUTURES_ROUTING_ENABLED=false

# --- Pause après pertes consécutives (19/08/2026) ---
# Valeurs de départ prudentes, à recalibrer une fois le taux de
# réussite réel de chaque moteur observé sur un échantillon
# statistiquement significatif (30 trades minimum, Confidence
# Lifecycle ADR-0015) - un ratio rendement/risque élevé signe
# généralement un taux de réussite < 50%, ce qui rend un seuil bas
# probable de se déclencher par pur hasard, pas seulement sur un vrai
# problème.
# MAX_CONSECUTIVE_LOSSES=3
# MAX_CONSECUTIVE_LOSS_PAUSE_HOURS=1

# --- Sauvegardes (stockage objet externe, Phase 3 §6 ; Module 2) ---
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_BUCKET=projet-quant-backups
BACKUP_RETENTION_DAYS=30
# BACKUP_HOUR_UTC=3

# --- Mode d'exécution du moteur ---
# ADR-0004/ADR-0008 : EXECUTION_MODE a été supprimé. Le mode courant est
# une entité gouvernée en base (execution_mode_state), modifiable
# uniquement via l'API (POST /execution-mode, phrase de confirmation
# "ACTIVER LIVE" pour le mode réel - Étape 6), jamais par une variable ici.

# --- Portefeuille réel (ADR-0003, ADR-0007) ---
# risk_engine lit le capital réel depuis portfolio_snapshots (service
# `portfolio`, interroge l'exchange directement). Aucune valeur de
# capital à définir ici - seule sa fraîcheur est configurable :
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=60
PORTFOLIO_SNAPSHOT_MAX_AGE_SECONDS=300
PORTFOLIO_RECONCILIATION_TOLERANCE=1

# --- Mur d'allocation du capital réel (Étape 5, 16/08/2026) ---
# Le pourcentage alloué N'EST PAS une variable d'environnement - c'est
# une entité gouvernée en base (capital_allocation_config), modifiable
# uniquement via POST /capital-allocation. Voir README.md, section
# "Configurer l'allocation de capital".

# --- Capital virtuel du Paper Portfolio (Étape 4, 16/08/2026) ---
# Également gouverné en base (paper_capital_config), pas ici -
# GET/POST /paper-capital. 1000 USDT par défaut au premier déploiement
# (migration 0022).

# --- Calibration probabiliste (ADR-0009) ---
CALIBRATION_INTERVAL_SECONDS=21600

# --- Machine Learning (Phase 16) ---
# Sans aucun effet actuellement : aucun module ne lit encore cette
# variable. Infrastructure construite mais volontairement non branchée
# sur le flux de décision live.
ML_ENABLED=false

# --- Data Normalizer (Phase 8) ---
# Délai maximal toléré avant de considérer un flux comme interrompu.
# GAP_THRESHOLD_SECONDS=60

# --- Notifications Telegram (Étape 10, 16/08/2026) ---
# UNE SEULE configuration pour tout le projet (consolidée le 16/08/2026 -
# monitoring/alerting.py, qui envoyait directement vers un second
# TELEGRAM_CHAT_ID indépendant, a été retiré : tout passe désormais par
# le service `notifications`). Voir README.md, section "Configurer
# Telegram", pour la procédure complète (BotFather, canaux, chat_id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALERTS=
TELEGRAM_CHAT_ID_LIVE=
TELEGRAM_CHAT_ID_PAPER=

# --- Sécurisation (Module 1) ---
# API_AUTH_TOKEN : générer avec `openssl rand -hex 32`, jamais exposé au navigateur.
# SESSION_SECRET : générer avec `openssl rand -hex 32`.
# DASHBOARD_PASSWORD_HASH : générer avec `node frontend/scripts/generate-password-hash.js "votre-mot-de-passe"`.
API_AUTH_TOKEN=
SESSION_SECRET=
DASHBOARD_PASSWORD_HASH=
RATE_LIMIT_PER_MINUTE=30
